<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_backup_odometry</name>
  <version>1.0.0</version>
  <description>
    Model-based backup odometry for a tram without GNSS/IMU: IMM Kalman filter over a
    nonlinear traction/braking model of the driver notch, corrected by front/rear bogie
    speeds with slip/slide detection; position constrained to a track map.
  </description>
  <maintainer email="team@example.com">MosTransHack team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tram_vehicle_msgs</depend>
  <depend>tbo_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
