# raw data stays local (jury gets it from organizers)
/data/*
!/data/splits.json
# colcon / cmake outputs
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/
/build*/
# python
__pycache__/
*.pyc
.pytest_cache/
# heavy intermediate artifacts
*.npz
*.db3
**/cache/
.vscode/
*.npy
*.wav
# local outputs of the fault suite, harness and analysis runs (regenerated by the scripts)
/tools/anomaly_sim/bin/
/tools/anomaly_sim/out/
/tools/anomaly_sim/results_cpp/*/*
!/tools/anomaly_sim/results_cpp/*/scenario_summary.csv
!/tools/anomaly_sim/results_cpp/*/false_alarms.csv
!/tools/anomaly_sim/results_cpp/*/meta.json
/tools/harness/bin/
/tools/harness/results/*
!/tools/harness/results/*summary*
!/tools/harness/results/*table*
/analysis/wheel_anomalies/aligned/
# not part of the solution: recording of the organisers' Q&A (summary kept) and notes on other projects
/research/qa_session/*
!/research/qa_session/QA_SUMMARY.md
/research/prior_work/
/tools/anomaly_sim/results_cpp/*.log
