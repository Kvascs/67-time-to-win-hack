# Raw data stays local (the jury gets it from the organisers); the split is part of the method
/data/*
!/data/splits.json

# Build outputs: colcon / CMake anywhere, local core builds
build/
install/
log/
/build*/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Heavy or binary intermediate artefacts (regenerated by the scripts)
*.npz
*.npy
*.db3
*.mcap
*.wav
*.zip
**/cache/
# run logs; analysis logs are kept, they hold the numbers quoted in docs/
*.log
!/analysis/**/*.log

# Local outputs of the fault suite, harness and analysis runs (summaries kept)
/tools/anomaly_sim/bin/
/tools/anomaly_sim/out/
/tools/anomaly_sim/results_cpp/*/*
!/tools/anomaly_sim/results_cpp/*/scenario_summary.csv
!/tools/anomaly_sim/results_cpp/*/false_alarms.csv
!/tools/anomaly_sim/results_cpp/*/meta.json
/tools/harness/bin/
/tools/harness/results/*
!/tools/harness/results/*summary*
!/tools/harness/results/*table*
/analysis/wheel_anomalies/aligned/

# Not part of the solution: recording of the organisers' Q&A (its summary is kept), notes on other projects
/research/qa_session/*
!/research/qa_session/QA_SUMMARY.md
/research/prior_work/
# regenerable intermediate data of the idea checks
/analysis/ideas_check/**/*.pkl
/analysis/ideas_check/**/*.parquet
/analysis/ideas_check/**/*.pt
/analysis/ideas_check/**/tmp/
/analysis/ideas_check/**/logs/
